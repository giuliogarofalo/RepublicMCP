# RepublicMCP Environment Variables

# Ollama model to use (default: gemma2:2b)
# Recommended models:
# - gemma2:2b (fast, good quality) ⭐
# - llama3.2:3b (balanced)
# - qwen2.5:3b (excellent for structured tasks)
# - mistral:7b (very accurate, slower)
OLLAMA_MODEL=gemma2:2b

# SPARQL endpoint (default: https://dati.camera.it/sparql)
# SPARQL_ENDPOINT=https://dati.camera.it/sparql

# --- OpenPolis "Openparlamento" (dati curati: indice di forza, presenze, votazioni, decreti, organi) ---
# OPENPOLIS_API=https://service.opdm.openpolis.io/api-openparlamento/v1
# OPENPOLIS_LEG=19          # legislatura (19 = XIX)
# OPENPOLIS_TOKEN=          # JWT opzionale: alza il limite di 10k req/giorno e sblocca Mappe del Potere
# OPENPOLIS_TTL=900         # cache in-memory (secondi); 0 = disabilita
